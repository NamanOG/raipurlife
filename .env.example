
# Raipur.life Environment Variables
# Copy this file to .env and fill in your actual values

# Site Configuration
VITE_SITE_NAME="Raipur.life"
VITE_SITE_URL="https://raipur.life"

# API Configuration (if needed in future)
VITE_API_BASE_URL="https://api.raipur.life"

# Supabase (required for live reviews, moderation, and contact submissions in production)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Optional free live events (Ticketmaster)
VITE_TICKETMASTER_API_KEY=""
VITE_EVENTS_CITY="Raipur"

# Optional live OpenStreetMap place replacement (disabled by default for curated launch content)
VITE_ENABLE_LIVE_PLACES="false"

# Optional Google location photos (Places API)
VITE_GOOGLE_PLACES_API_KEY=""

# Analytics (optional)
VITE_GA_TRACKING_ID=""

# Social Media
VITE_TWITTER_HANDLE="@raipur_life"
VITE_INSTAGRAM_HANDLE="@raipurlife"

# Contact Information
VITE_CONTACT_EMAIL="hello@raipur.life"
VITE_CONTACT_PHONE="+91 98765 43210"
